# ===========================================
# yamb 环境变量示例
# 复制为 .env（单 bot）或 .env.botN（多 bot）后再填写
# 游戏内命令和功能设置请编辑 config/game/ 目录
# ===========================================

# Minecraft 服务器与账号
MC_HOST=mc.zenoxs.cn
MC_PORT=25565
MC_USERNAME=your_microsoft_email@example.com
# microsoft 登录不需要密码；offline/mojang 认证按服务器要求填写
MC_PASSWORD=
MC_AUTH=microsoft
MC_PROFILES_FOLDER=./mc-tokens
MC_VERSION=false
MC_CHECK_TIMEOUT=300000
# 高视距功能（使用、放置、看向、跳跃）临时使用的区块视距
MC_HIGH_VIEW_DISTANCE=12
# 破基岩追踪放置使用的固定区块视距
MC_BREAK_VIEW_DISTANCE=8
# 某些服务器需要关闭聊天签名
MC_DISABLE_CHAT_SIGNING=true

# 多 bot 身份（单 bot 也建议填写 BOT_NAME）
BOT_NAME=your_bot_name
BOT_INDEX=1
# 自动待命/重连时的基地范围；不使用范围时保持 0
BOT_BASE_MIN_X=0
BOT_BASE_MAX_X=0
BOT_BASE_MIN_Z=0
BOT_BASE_MAX_Z=0

# 多 bot 必须共用同一个数据库文件；单 bot 保持默认即可
MC_DB_FILE=./data/md/mchatbot.db

# AstrBot (QQ群) — 设为 true 启用
ASTRBOT_ENABLED=false
API_PORT=15100
API_KEY=

# 消息队列
QUEUE_MAX_SIZE=100
QUEUE_DELAY_MS=1000

# 管理员游戏名（逗号分隔）
MC_ADMIN_LIST=your_admin_name

# 可选：内存监控（默认值通常无需修改）
# MC_MEMORY_WATCH_INTERVAL_MS=30000
# MC_MEMORY_WARN_RATIO=0.85
# MC_MEMORY_SNAPSHOT_RATIO=0.92
# MC_MEMORY_RESTART=0
# MC_MEMORY_GC=1

# 可选：区块/实体清理（设为 0 可关闭）
# MC_CHUNK_PRUNER=1
# MC_CHUNK_PRUNER_INTERVAL_MS=20000
# MC_CHUNK_PRUNER_MARGIN=1
# MC_ENTITY_PRUNER=1
# MC_ENTITY_PRUNER_INTERVAL_MS=30000
# MC_ENTITY_PRUNER_RADIUS=64

# 旧版 BOT_TELEPORT_CONFIG、BOT_PHOME_OWNED 已废弃。
# 所有传送点统一写在 config/game/teleport.json，owner 字段决定归属 bot。
